# Auto Media — copy to .env and fill secrets (UTF-8)

# Release images (GHCR, public). Dev: leave local + policy auto → compose build.
# Production / low-spec: AUTO_MEDIA_VERSION=v0.1.0 then pull (no local npm/codex build).
AUTO_MEDIA_VERSION=local
AUTO_MEDIA_IMAGE_POLICY=auto
# AUTO_MEDIA_N8N_IMAGE=ghcr.io/undefinedgod2718/auto-media-n8n:v0.1.0
# AUTO_MEDIA_GATEWAY_IMAGE=ghcr.io/undefinedgod2718/auto-media-gateway:v0.1.0

GENERIC_TIMEZONE=Asia/Taipei
TZ=Asia/Taipei

# n8n
N8N_ENCRYPTION_KEY=change-me-to-random-32-chars-min
N8N_HOST=localhost
N8N_PORT=5678
# n8n-MCP (Cursor / Claude) — n8n UI: Settings → n8n API → Create API Key
N8N_API_URL=http://localhost:5678
# Dev Container: sync/enforce/verify scripts reach host Docker n8n
N8N_SYNC_API_URL=http://host.docker.internal:5678
N8N_API_KEY=
# Public HTTPS base for n8n webhooks (Telegram HITL). Dev: n8n tunnel URL.
WEBHOOK_URL=

# Telegram HITL
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret (1-256 chars) for Telegram webhook auth. Set on setWebhook
# (secret_token) and verified by the Gateway /telegram endpoint. Without it the
# Gateway refuses all Telegram updates (no unauthenticated pipeline triggers).
TELEGRAM_WEBHOOK_SECRET=

# B-prime Gateway (telegram_poll_forwarder; native host: localhost:8787)
GATEWAY_URL=http://localhost:8787
# Dev Container: auto-probes host.docker.internal / 172.17.0.1, or set explicitly:
# GATEWAY_POLL_URL=http://172.17.0.1:8787
# compose: n8n → gateway service; host-only gateway: http://host.docker.internal:8787
GATEWAY_RUN_MODE=compose
N8N_GATEWAY_URL=http://gateway:8787
GATEWAY_PUBLIC_URL=
GATEWAY_INTERNAL_SECRET=
GATEWAY_PORT=8787
# Skill/engines unlock PIN (min 8 chars). Empty = default 12345678; change at http://127.0.0.1:8790/settings
AUTO_MEDIA_DASHBOARD_WRITE_PIN=
# Gateway container → n8n (compose DNS); Dev Container scripts → host Docker
GATEWAY_N8N_API_URL=http://n8n:5678
# VERIFY_CLAUDE_STRICT=1  # start_production.sh / CI: fail if n8n lacks claude auth

# Meta Graph API (Plan A) — long-lived tokens expire (~60d); refresh via Graph API Explorer
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
# META_APP_ID=
# META_APP_SECRET=
# Instagram Business (Page-linked). Page token scopes (Graph API Explorer → your Page):
# pages_manage_posts, pages_read_engagement (required for FB /feed and /photos),
# pages_show_list, instagram_basic, instagram_content_publish (if publishing IG).
# Optional: META_APP_ID + META_APP_SECRET enable scope check in verify_meta_tokens.sh
# IG_USER_ID=$(curl -s "https://graph.facebook.com/v21.0/${META_PAGE_ID}?fields=instagram_business_account&access_token=${META_PAGE_ACCESS_TOKEN}" | jq -r '.instagram_business_account.id')
IG_USER_ID=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# After updating tokens: docker compose up -d n8n && bash scripts/verify_meta_tokens.sh
# Host CLI (Dev Container): if mkdir hits /data Permission denied, use:
#   export DATA_ROOT="$(pwd)/data"
# Or rely on scripts/lib/common.sh (skips non-writable /data/runs).

# Claude Code — required when engines.copy.provider is claude_cli
# OAuth: claude → /login, then ./scripts/sync_claude_oauth.sh
# ANTHROPIC_API_KEY=          # https://console.anthropic.com/
# CLAUDE_CODE_OAUTH_TOKEN=    # from: claude setup-token
CLAUDE_CONFIG_DIR=./data/secrets/claude
CODEX_CONFIG_DIR=./data/secrets/codex
# n8n image: INSTALL_CODEX=true (default in docker-compose build args)
# INSTALL_CODEX=false

# Gemini CLI — required when engines.copy.provider is gemini_cli
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OAuth cache for n8n container (mount → /home/node/.gemini); run `gemini` once to populate
GEMINI_CONFIG_DIR=./data/secrets/gemini

# Dev Container only: host Docker socket (see docs/DEVCONTAINER.md)
# DOCKER_HOST=unix:///var/run/docker-host.sock

# amctl apply: allow missing claude/codex/gemini during post-create (not for production)
# AUTO_MEDIA_ALLOW_MISSING_CLI=1

# Development: skip real CLI calls (mock file outputs)
AUTO_MEDIA_MOCK=0

# Optional: force UTF-8 in containers
LANG=C.UTF-8
LC_ALL=C.UTF-8
