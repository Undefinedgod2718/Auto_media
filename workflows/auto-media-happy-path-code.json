{
  "name": "auto-media-happy-path",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "hours", "hoursInterval": 24}]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\ntry {\n  const output = execSync('cat /data/config/platform.runtime.json', { encoding: 'utf8' });\n  return [{ json: { stdout: output } }];\n} catch(e) {\n  return [{ json: { stdout: '', note: 'platform.runtime.json not found, continuing' } }];\n}",
        "mode": "runOnceForAllItems"
      },
      "id": "load-runtime",
      "name": "Load platform.runtime.json",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "run_id", "name": "run_id", "value": "={{ $now.format('yyyyMMdd-HHmmss') }}-{{ $execution.id }}", "type": "string"},
            {"id": "topic", "name": "topic", "value": "從腦科學與執行功能（05–07）來看，台灣正在面對「有AI工具、卻不知道怎麼教」的現場焦慮，呼應多可在課程設計上對「過程比工具更重要」的堅持", "type": "string"},
            {"id": "audience", "name": "audience", "value": "台灣教師、課程設計師、教育工作者（25-45歲）", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "set-context",
      "name": "Set run context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\nconst runId = $input.item.json.run_id;\nconst topic = $input.item.json.topic;\nconst audience = $input.item.json.audience;\ntry {\n  const cmd = `mkdir -p /data/runs/${runId} && /bin/bash /data/scripts/write_task.sh --run-id \"${runId}\" --topic \"${topic}\" --audience \"${audience}\" --action generate_copy`;\n  const output = execSync(cmd, { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] });\n  return [{ json: { stdout: output, run_id: runId, topic, audience } }];\n} catch(e) {\n  throw new Error(`Write TASK.md failed: ${e.message}\\nstderr: ${e.stderr || ''}`);\n}",
        "mode": "runOnceForAllItems"
      },
      "id": "write-task",
      "name": "Write TASK.md",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\nconst runId = $('Set run context').item.json.run_id;\ntry {\n  const output = execSync(`/bin/bash /data/scripts/invoke-engine.sh --run-id \"${runId}\" --engine copywriter`, { encoding: 'utf8', timeout: 300000, stdio: ['pipe', 'pipe', 'pipe'] });\n  return [{ json: { stdout: output, run_id: runId } }];\n} catch(e) {\n  throw new Error(`Invoke copywriter failed: ${e.message}\\nstderr: ${e.stderr || ''}`);\n}",
        "mode": "runOnceForAllItems"
      },
      "id": "invoke-copy",
      "name": "Invoke copywriter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -80]
    },
    {
      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\nconst runId = $('Set run context').item.json.run_id;\ntry {\n  const output = execSync(`/bin/bash /data/scripts/invoke-engine.sh --run-id \"${runId}\" --engine svg_artist`, { encoding: 'utf8', timeout: 300000, stdio: ['pipe', 'pipe', 'pipe'] });\n  return [{ json: { stdout: output, run_id: runId } }];\n} catch(e) {\n  throw new Error(`Invoke svg artist failed: ${e.message}\\nstderr: ${e.stderr || ''}`);\n}",
        "mode": "runOnceForAllItems"
      },
      "id": "invoke-svg",
      "name": "Invoke svg artist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 80]
    },
    {
      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\nconst runId = $('Set run context').item.json.run_id;\ntry {\n  const output = execSync(`/bin/bash /data/scripts/render_png.sh --run-id \"${runId}\"`, { encoding: 'utf8', timeout: 120000, stdio: ['pipe', 'pipe', 'pipe'] });\n  return [{ json: { stdout: output, run_id: runId } }];\n} catch(e) {\n  throw new Error(`Render PNG failed: ${e.message}\\nstderr: ${e.stderr || ''}`);\n}",
        "mode": "runOnceForAllItems"
      },
      "id": "render-png",
      "name": "Render PNG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "=/data/runs/{{ $('Set run context').item.json.run_id }}/post.png",
        "options": {}
      },
      "id": "read-png",
      "name": "Read post.png",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1320, -40]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "=/data/runs/{{ $('Set run context').item.json.run_id }}/post.md",
        "options": {}
      },
      "id": "read-md",
      "name": "Read post.md",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1320, 40]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "binaryData": true,
        "additionalFields": {
          "caption": "={{ $('Read post.md').item.json.data }}",
          "message_thread_id": "={{ $env.TELEGRAM_THREAD_ID }}"
        }
      },
      "id": "telegram-preview",
      "name": "Telegram HITL preview",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1540, 0],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {"resume": "webhook", "options": {}},
      "id": "wait-approval",
      "name": "Wait for approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1760, 0],
      "webhookId": "auto-media-hitl"
    },
    {
      "parameters": {
        "rules": {
          "values": [{
            "conditions": {
              "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
              "conditions": [{
                "leftValue": "={{ $json.body?.callback || $json.callback }}",
                "rightValue": "approve",
                "operator": {"type": "string", "operation": "equals"}
              }],
              "combinator": "and"
            },
            "renameOutput": true,
            "outputKey": "approve"
          }]
        },
        "options": {"fallbackOutput": "extra"}
      },
      "id": "switch-callback",
      "name": "Switch callback",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1980, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.META_GRAPH_API_VERSION }}/{{ $env.META_PAGE_ID }}/photos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{"name": "access_token", "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}"}]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [{"name": "message", "value": "={{ $('Read post.md').item.json.data }}"}]
        },
        "options": {"response": {"response": {"fullResponse": true}}}
      },
      "id": "meta-publish",
      "name": "Meta Graph API publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, -40]
    },
    {
      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\nconst runId = $('Set run context').item.json.run_id;\nconst statusCode = $input.item.json.statusCode || '';\nconst body = JSON.stringify($input.item.json.body || '');\ntry {\n  const output = execSync(`/bin/bash /data/scripts/write_circuit_breaker.sh \"${runId}\" \"${statusCode}\" '${body}'`, { encoding: 'utf8' });\n  return [{ json: { stdout: output } }];\n} catch(e) {\n  return [{ json: { error: e.message } }];\n}",
        "mode": "runOnceForAllItems"
      },
      "id": "circuit-breaker",
      "name": "Write api_dead.json",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 120]
    }
  ],
  "connections": {
    "Schedule Trigger": {"main": [[{"node": "Load platform.runtime.json", "type": "main", "index": 0}]]},
    "Load platform.runtime.json": {"main": [[{"node": "Set run context", "type": "main", "index": 0}]]},
    "Set run context": {"main": [[{"node": "Write TASK.md", "type": "main", "index": 0}]]},
    "Write TASK.md": {"main": [[{"node": "Invoke copywriter", "type": "main", "index": 0}, {"node": "Invoke svg artist", "type": "main", "index": 0}]]},
    "Invoke copywriter": {"main": [[{"node": "Render PNG", "type": "main", "index": 0}]]},
    "Invoke svg artist": {"main": [[{"node": "Render PNG", "type": "main", "index": 0}]]},
    "Render PNG": {"main": [[{"node": "Read post.png", "type": "main", "index": 0}, {"node": "Read post.md", "type": "main", "index": 0}]]},
    "Read post.png": {"main": [[{"node": "Telegram HITL preview", "type": "main", "index": 0}]]},
    "Read post.md": {"main": [[{"node": "Telegram HITL preview", "type": "main", "index": 0}]]},
    "Telegram HITL preview": {"main": [[{"node": "Wait for approval", "type": "main", "index": 0}]]},
    "Wait for approval": {"main": [[{"node": "Switch callback", "type": "main", "index": 0}]]},
    "Switch callback": {"main": [[{"node": "Meta Graph API publish", "type": "main", "index": 0}], [], []]},
    "Meta Graph API publish": {"main": [[], [{"node": "Write api_dead.json", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1", "errorWorkflow": ""},
  "staticData": null,
  "meta": {"templateCredsSetupCompleted": false},
  "pinData": {}
}
