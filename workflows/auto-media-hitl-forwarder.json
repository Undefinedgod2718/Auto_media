        "url": "={{ $json.resume_url }}",
        "options": {}
      },
      "id": "resume-hitl-v1",
      "name": "Resume Wait hitl-v1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.resume_url }}",
        "options": {}
      },
      "id": "resume-hitl-v2",
      "name": "Resume Wait hitl-v2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -40
      ]
    },
    {
      "parameters": {
        "command": "=`/bin/bash /data/scripts/read_hitl_reply_map.sh --message-id ${String($json.reply_to_message_id || '')}`"
      },
      "id": "read-reply-map",
      "name": "Read HITL reply map",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const mapRaw = $input.item.json.stdout || '{}';\nlet map;\ntry { map = JSON.parse(mapRaw); } catch (e) { throw new Error('invalid reply map JSON: ' + mapRaw); }\nconst fb = $('Parse Telegram update').item.json;\nreturn { json: { run_id: map.run_id, stage: map.stage || 'v1', decision: map.decision || 'revise', feedback_text: fb.feedback_text || '' } };"
      },
      "id": "merge-feedback",
      "name": "Merge feedback payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WEBHOOK_URL || 'http://localhost:5678').replace(/\\/$/, '') + '/webhook-wait/auto-media-feedback-v1' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $json.run_id, feedback_text: $json.feedback_text, decision: $json.decision, stage: $json.stage }) }}",
        "options": {}
      },
      "id": "resume-feedback-v1",
      "name": "Resume Wait feedback-v1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/answerCallbackQuery",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"callback_query_id\": \"{{ $('Parse Telegram update').item.json.callback_query_id }}\",\n  \"text\": \"{{ $('Parse Telegram update').item.json.callback === 'approve' ? '✅ 已收到核准' : $('Parse Telegram update').item.json.callback === 'revise' ? '🛠 已收到修正指示，請回覆建議' : '❌ 已收到拒絕，請回覆修正意見' }}\",\n  \"show_alert\": false\n}",
        "options": {}
      },
      "id": "answer-callback",
      "name": "Answer callback query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -120
      ]
    },
    {
      "parameters": {
        "command": "=/bin/bash /data/scripts/read_hitl_resume_map.sh --run-id \"{{ $('Parse Telegram update').item.json.run_id }}\" --stage \"{{ $('Parse Telegram update').item.json.stage }}\""
      },
      "id": "read-resume-aefa05997726",
      "name": "Read wait resume map",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        -280
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json.stdout || '{}';\nlet map;\ntry { map = JSON.parse(raw); } catch (e) { throw new Error('invalid resume map: ' + raw); }\nconst cb = $('Parse Telegram update').item.json;\nif (!map.resume_url) throw new Error('resume_url missing');\nlet url = String(map.resume_url);\nurl = url.replace(/\\/(auto-media-[^/?&]+)$/, '');\nurl = url.replace(/(signature=[^&]+)\\/auto-media-[^&]+/, '$1');\nconst sep = url.indexOf('?') >= 0 ? '&' : '?';\nconst resume_url = url + sep + 'callback=' + encodeURIComponent(cb.callback) + '&run_id=' + encodeURIComponent(cb.run_id) + '&stage=' + encodeURIComponent(cb.stage);\nreturn { json: { ...cb, resume_url } };"
      },
      "id": "parse-resume-5896e0408893",
      "name": "Parse wait resume map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        -280
      ]
    }
  ],
