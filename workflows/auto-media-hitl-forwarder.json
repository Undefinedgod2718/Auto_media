        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-telegram-in",
      "name": "Webhook Telegram IN",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -220,
        120
      ],
      "webhookId": "auto-media-telegram-in"
    },
    {
      "parameters": {
        "updates": [
          "callback_query",
          "message"
        ]
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "disabled": true,
      "notes": "Enable when WEBHOOK_URL is HTTPS (production). Local dev: use Webhook Telegram IN + scripts/telegram_poll_forwarder.sh",
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json;\nconst u = raw.callback_query || raw.message ? raw : (raw.body || raw);\nif (u.callback_query) {\n  const data = String(u.callback_query.data || '');\n  const m = data.match(/^am:(v\\d+):(approve|reject|revise):([A-Za-z0-9._-]+)$/);\n  if (!m) return { json: { kind: 'ignore', reason: 'invalid callback_data', data } };\n  return { json: { kind: 'callback', stage: m[1], callback: m[2], run_id: m[3], callback_query_id: u.callback_query.id } };\n}\nif (u.message?.reply_to_message) {\n  return { json: { kind: 'feedback', reply_to_message_id: u.message.reply_to_message.message_id, feedback_text: u.message.text || '' } };\n}\nreturn { json: { kind: 'ignore', reason: 'not callback_query or force-reply message' } };"
      },
      "id": "parse-telegram",
      "name": "Parse Telegram update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "rightValue": "callback",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "callback"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "rightValue": "feedback",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "feedback"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "route-kind",
      "name": "Route update kind",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
