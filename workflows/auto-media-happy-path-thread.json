{
  "name": "auto-media-happy-path",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "hours", "hoursInterval": 24}]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {"command": "cat /data/config/platform.runtime.json"},
      "id": "load-runtime",
      "name": "Load platform.runtime.json",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "run_id", "name": "run_id", "value": "={{ $now.format('yyyyMMdd-HHmmss') }}-{{ $execution.id }}", "type": "string"},
            {"id": "topic", "name": "topic", "value": "AI 發展趨勢", "type": "string"},
            {"id": "audience", "name": "audience", "value": "25-35 歲科技愛好者", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "set-context",
      "name": "Set run context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "command": "=mkdir -p /data/runs/{{ $json.run_id }} && /bin/bash /data/scripts/write_task.sh --run-id \"{{ $json.run_id }}\" --topic \"{{ $json.topic }}\" --audience \"{{ $json.audience }}\" --action generate_copy"
      },
      "id": "write-task",
      "name": "Write TASK.md",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [660, 0]
    },
    {
      "parameters": {
        "command": "=/bin/bash /data/scripts/invoke-engine.sh --run-id \"{{ $('Set run context').item.json.run_id }}\" --engine copywriter"
      },
      "id": "invoke-copy",
      "name": "Invoke copywriter",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [880, -80]
    },
    {
      "parameters": {
        "command": "=/bin/bash /data/scripts/invoke-engine.sh --run-id \"{{ $('Set run context').item.json.run_id }}\" --engine svg_artist"
      },
      "id": "invoke-svg",
      "name": "Invoke svg artist",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [880, 80]
    },
    {
      "parameters": {
        "command": "=/bin/bash /data/scripts/render_png.sh --run-id \"{{ $('Set run context').item.json.run_id }}\""
      },
      "id": "render-png",
      "name": "Render PNG",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "fileSelector": "=/data/runs/{{ $('Set run context').item.json.run_id }}/post.png",
        "options": {}
      },
      "id": "read-png",
      "name": "Read post.png",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1320, -40]
    },
    {
      "parameters": {
        "fileSelector": "=/data/runs/{{ $('Set run context').item.json.run_id }}/post.md",
        "options": {}
      },
      "id": "read-md",
      "name": "Read post.md",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1320, 40]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "binaryData": true,
        "additionalFields": {
          "caption": "={{ $('Read post.md').item.json.data }}",
          "message_thread_id": "={{ $env.TELEGRAM_THREAD_ID }}"
        }
      },
      "id": "telegram-preview",
      "name": "Telegram HITL preview",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1540, 0],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {"resume": "webhook", "options": {}},
      "id": "wait-approval",
      "name": "Wait for approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1760, 0],
      "webhookId": "auto-media-hitl"
    },
    {
      "parameters": {
        "rules": {
          "values": [{
            "conditions": {
              "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
              "conditions": [{
                "leftValue": "={{ $json.body?.callback || $json.callback }}",
                "rightValue": "approve",
                "operator": {"type": "string", "operation": "equals"}
              }],
              "combinator": "and"
            },
            "renameOutput": true,
            "outputKey": "approve"
          }]
        },
        "options": {"fallbackOutput": "extra"}
      },
      "id": "switch-callback",
      "name": "Switch callback",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1980, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.META_GRAPH_API_VERSION }}/{{ $env.META_PAGE_ID }}/photos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{"name": "access_token", "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}"}]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [{"name": "message", "value": "={{ $('Read post.md').item.json.data }}"}]
        },
        "options": {"response": {"response": {"fullResponse": true}}}
      },
      "id": "meta-publish",
      "name": "Meta Graph API publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, -40]
    },
    {
      "parameters": {
        "command": "=/bin/bash /data/scripts/write_circuit_breaker.sh \"{{ $('Set run context').item.json.run_id }}\" \"{{ $json.statusCode }}\" \"{{ $json.body }}\""
      },
      "id": "circuit-breaker",
      "name": "Write api_dead.json",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2200, 120]
    }
  ],
  "connections": {
    "Schedule Trigger": {"main": [[{"node": "Load platform.runtime.json", "type": "main", "index": 0}]]},
    "Load platform.runtime.json": {"main": [[{"node": "Set run context", "type": "main", "index": 0}]]},
    "Set run context": {"main": [[{"node": "Write TASK.md", "type": "main", "index": 0}]]},
    "Write TASK.md": {"main": [[{"node": "Invoke copywriter", "type": "main", "index": 0}, {"node": "Invoke svg artist", "type": "main", "index": 0}]]},
    "Invoke copywriter": {"main": [[{"node": "Render PNG", "type": "main", "index": 0}]]},
    "Invoke svg artist": {"main": [[{"node": "Render PNG", "type": "main", "index": 0}]]},
    "Render PNG": {"main": [[{"node": "Read post.png", "type": "main", "index": 0}, {"node": "Read post.md", "type": "main", "index": 0}]]},
    "Read post.png": {"main": [[{"node": "Telegram HITL preview", "type": "main", "index": 0}]]},
    "Read post.md": {"main": [[{"node": "Telegram HITL preview", "type": "main", "index": 0}]]},
    "Telegram HITL preview": {"main": [[{"node": "Wait for approval", "type": "main", "index": 0}]]},
    "Wait for approval": {"main": [[{"node": "Switch callback", "type": "main", "index": 0}]]},
    "Switch callback": {"main": [[{"node": "Meta Graph API publish", "type": "main", "index": 0}], [], []]},
    "Meta Graph API publish": {"main": [[], [{"node": "Write api_dead.json", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1", "errorWorkflow": ""},
  "staticData": null,
  "meta": {"templateCredsSetupCompleted": false},
  "pinData": {}
}
